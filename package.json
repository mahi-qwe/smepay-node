{
  "name": "smepay-node",
  "version": "0.1.1",
  "description": "Official Node.js SDK for the SMEPay External API (UPI payments).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahi-qwe/smepay-node.git"
  },
  "homepage": "https://github.com/mahi-qwe/smepay-node#readme",
  "bugs": {
    "url": "https://github.com/mahi-qwe/smepay-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "smepay",
    "upi",
    "payments",
    "sdk"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
